<div class="flex flex-wrap items-center gap-2 text-sm">
  <%= if @current_user do %>
    <div class="max-w-xs truncate rounded-md bg-slate-200 px-3 py-2 font-medium text-slate-800"><%= @current_user.email %></div>
    <div><%= link "Settings", to: Routes.user_settings_path(@conn, :edit), class: "rounded-md px-3 py-2 font-medium text-slate-700 hover:bg-slate-200 hover:text-slate-950" %></div>
    <div><%= link "Log out", to: Routes.user_session_path(@conn, :delete), method: :delete, class: "rounded-md px-3 py-2 font-medium text-slate-700 hover:bg-slate-200 hover:text-slate-950" %></div>
  <% else %>
    <div><%= link "Register", to: Routes.user_registration_path(@conn, :new), class: "rounded-md px-3 py-2 font-medium text-slate-700 hover:bg-slate-200 hover:text-slate-950" %></div>
    <div><%= link "Log in", to: Routes.user_session_path(@conn, :new), class: "rounded-md bg-sky-600 px-3 py-2 font-semibold text-white shadow-sm hover:bg-sky-700" %></div>
  <% end %>
</div>
