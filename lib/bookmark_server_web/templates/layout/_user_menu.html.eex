<div class="flex flex-row">
  <%= if @current_user do %>
    <div class="m-2"><%= @current_user.email %></div>
    <div class="m-2"><%= link "Settings", to: Routes.user_settings_path(@conn, :edit) %></div>
    <div class="m-2"><%= link "Log out", to: Routes.user_session_path(@conn, :delete), method: :delete %></div>
  <% else %>
    <div class="m-2"><%= link "Register", to: Routes.user_registration_path(@conn, :new) %></div>
    <div class="m-2"><%= link "Log in", to: Routes.user_session_path(@conn, :new) %></div>
  <% end %>
</div>
