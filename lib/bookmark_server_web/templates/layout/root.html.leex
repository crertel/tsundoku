<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <%= csrf_meta_tag() %>
    <title><%= assigns[:page_title] || "Bookmark Server" %></title>
    <link phx-track-static rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/app.css") %>"/>
    <script defer phx-track-static type="text/javascript" src="<%= Routes.static_path(@conn, "/assets/app.js") %>"></script>
  </head>
  <body class="min-h-screen bg-slate-300 text-slate-950 antialiased">
    <header class="border-b border-slate-300 bg-slate-100 shadow-sm">
      <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <nav role="navigation" class="flex min-h-16 flex-col gap-3 py-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-wrap items-center gap-2">
            <%= link "Bookmark Server", to: Routes.page_path(@conn, :index), class: "mr-3 text-lg font-semibold text-slate-950 hover:text-sky-700" %>
            <%= if function_exported?(Routes, :live_dashboard_path, 2) do %>
              <div>
                <%= link "Dashboard", to: Routes.live_dashboard_path(@conn, :home), class: "rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 hover:text-slate-950" %>
              </div>
            <% end %>
            <div>
              <%= link "Tags", to: Routes.tag_index_path(@conn, :index), class: "rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 hover:text-slate-950" %>
            </div>
            <div>
              <%= link "Sites", to: Routes.site_index_path(@conn, :index), class: "rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 hover:text-slate-950" %>
            </div>
          </div>
          <%= render "_user_menu.html", assigns %>
        </nav>
      </section>
    </header>
    <div>
      <%= @inner_content %>
    </div>
  </body>
</html>
