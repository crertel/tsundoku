<section class="mx-auto flex min-h-[calc(100vh-8rem)] max-w-7xl items-center px-4 py-10 sm:px-6 lg:px-8">
  <div class="w-full max-w-md rounded-lg border border-slate-400 bg-slate-100 p-6 shadow-sm">
    <div class="text-2xl font-semibold text-slate-950">
      <h1>Forgot your password?</h1>
    </div>

<div class="mt-6">
  <%= form_for :user, Routes.user_reset_password_path(@conn, :create), fn f -> %>
    <div class="space-y-5">
      <div>
        <%= label f, :email, class: "block text-sm font-medium text-slate-700" %>
        <%= email_input f, :email, required: true, class: "mt-2 block w-full rounded-md border border-slate-400 bg-slate-50 px-3 py-2 text-slate-950 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200" %>
      </div>

      <div>
        <%= submit "Send instructions to reset password", class: "w-full rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-sky-700" %>
      </div>
    </div>
  <% end %>
</div>

<p class="mt-5 flex flex-wrap gap-x-3 gap-y-2 text-sm">
  <%= link "Register", to: Routes.user_registration_path(@conn, :new), class: "font-medium text-sky-700 hover:text-sky-900" %>
  <%= link "Log in", to: Routes.user_session_path(@conn, :new), class: "font-medium text-sky-700 hover:text-sky-900" %>
</p>
  </div>
</section>
