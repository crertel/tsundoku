<div class="place-items-center m-48 p-12 bg-gray-400 max-w-2xl">
  <h1 class="text-3xl">Log in</h1>

  <div class="p-4">
    <%= form_for @conn, Routes.user_session_path(@conn, :create), [as: :user], fn f -> %>
      <%= if @error_message do %>
        <div class="alert alert-danger">
          <p><%= @error_message %></p>
        </div>
      <% end %>
      <div class="grid grid-cols-12">
        <div class="col-span-12 ">
          <%= label f, :email %>
        </div>
        <div class="col-span-12 p-2">
          <%= email_input f, :email, required: true, placeholder: "Email" %>
        </div>

        <div class="col-span-12">
          <%= label f, :password %>
        </div>
        <div class="col-span-12 p-2">
          <%= password_input f, :password, required: true, placeholder: "Password" %>
        </div>

        <div class="col-span-12 p-2">
          <%= submit "Log in", class: "bg-blue-300 p-2" %>
        </div>
        <div class="col-span-12 p-4">
            <%= link "Register", to: Routes.user_registration_path(@conn, :new), class: "hover:blue-300" %> |
            <%= link "Forgot your password?", to: Routes.user_reset_password_path(@conn, :new), class: "hover:blue-300"  %>
        </div>
      </div>
    <% end %>
  </div>
</div>
