<div class="p-4">
<div class="flex justify-between">
    <div><h1 class="text-lg  border-b-2 border-black">Listing Sites</h1></div>
    <div>
      <div class="bg-blue-300 hover:text-blue-500 w-40 text-center rounded-xl m-2">
        <%= live_patch "Create New Site", to: Routes.site_index_path(@socket, :new) %>
      </div>
    </div>
  </div>

  <div>
    <%= for entry <- @uploads.bookmark_import.entries do %>
    <div class="w-300">
      <%= entry.client_name %> - <progress max="100" value="<%= entry.progress %>" />
      </div>
    <% end %>

    <%= for {_ref, msg} <- @uploads.bookmark_import.errors do %>
      <%= msg %>
    <% end %>

    <form id="import-bookmark-form" phx-submit="upload-bookmark" phx-change="validate-upload">
      <%= live_file_input @uploads.bookmark_import %>
      <%= submit "Import" %>
    </form>
  </div>

  <%= if @live_action in [:new, :edit] do %>
    <%= live_modal @socket, BookmarkServerWeb.SiteLive.FormComponent,
      id: @site.id || :new,
      title: @page_title,
      action: @live_action,
      site: @site,
      return_to: Routes.site_index_path(@socket, :index) %>
  <% end %>

  <div id="tags" class="p-2">
    <%= if length(@sites) > 0 do %>
    <nav class="border-t border-gray-200 m-4">
        <ul class="flex my-2">
          <li> <a class="px-2 py-2 <%= if @page_number <= 1, do: "pointer-events-none text-gray-600" %>" href="#" phx-click="nav" phx-value-page="<%= @page_number + 1 %>">Previous</a> </li>
      <%= for idx <-  Enum.to_list(1..@total_pages) do %>
          <li > <a class="px-2 py-2 border-b-2 hover:border-blue-200<%= if @page_number == idx, do: "pointer-events-none text-gray-600 border-b-2 border-blue-400" %>" href="#" phx-click="nav" phx-value-page="<%= idx %>"><%= idx %></a> </li>
      <% end %>
          <li> <a class="px-2 py-2 <%= if @page_number >= @total_pages, do: "pointer-events-none text-gray-600" %>" href="#" phx-click="nav" phx-value-page="<%= @page_number + 1 %>">Next</a> </li>
        </ul>
      </nav>
      <%= for site <- @sites do %>
        <div id="tag-<%= site.id %>" class="bg-gray-100 grid grid-cols-12">
          <div class="col-span-1">
            <div class="inline hover:text-blue-500"><%= live_redirect "Show", to: Routes.site_show_path(@socket, :show, site) %></div>
            <div class="inline hover:text-blue-500"><%= live_patch "Edit", to: Routes.site_index_path(@socket, :edit, site) %></div>
            <div class="inline hover:text-blue-500"><%= link "Delete", to: "#", phx_click: "delete", phx_value_id: site.id, data: [confirm: "Are you sure?"] %></div>
          </div>
          <div class="col-span-5">
            <div>
              <a href="<%= site.url %>" class="hover:text-blue-500" target="_blank">
                <%= if site.display_name == "" do%>
                  <%= site.url %>
                <% else  %>
                  <%= site.display_name %>
                <% end %>
              </a>
            </div>
          </div>
          <div class="col-span-6">
            <div class="flex">
              <%= if length(site.tags) > 0 do %>
                <%= for tag <- site.tags do %>
                  <div class="m-1 rounded-full bg-blue-200 p-1 px-2">
                    <%= tag.name %>
                  </div>
                <% end %>
              <% else %>
                No tags assigned.
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      No sites defined.
    <% end %>
  </div>
</div>
