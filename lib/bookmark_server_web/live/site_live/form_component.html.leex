<h2><%= @title %></h2>

<%= f = form_for @changeset, "#",
  id: "site-form",
  phx_target: @myself,
  phx_change: "validate",
  phx_submit: "save" %>

  <%= label f, :url %>
  <%= text_input f, :url%>
  <%= error_tag f, :url %>

  <%= label f, :tag, list: "tag_list" %>
  <%= text_input f, :tag, list: "tag_list"%>
  <datalist id="tag_list">
    <%= for tag <- @available_tags do %>
      <option value="<%= tag.name%>">
    <% end %>
  </datalist>

  <h2>available tags </h2>
  <%= inspect @available_tags %>
  <br>
  <h2>active tags </h2>
  <%= inspect @active_tags %>
  <br>
  <h2> site</h2>
  <%= inspect @site %>

  <%= submit "Save", phx_disable_with: "Saving..." %>
</form>
