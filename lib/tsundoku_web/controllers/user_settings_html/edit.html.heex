<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-8">
    <div class="text-2xl font-semibold text-slate-950">
      <h1>Settings</h1>
    </div>
  </div>

  <div class="mb-8 grid gap-6 sm:grid-cols-2">
    <.link
      href={~p"/import"}
      class="block rounded-lg border border-slate-400 bg-slate-100 p-6 shadow-sm hover:border-sky-500 hover:bg-sky-50"
    >
      <h3 class="text-lg font-semibold text-slate-950">Import bookmarks</h3>
      <p class="mt-1 text-sm text-slate-700">
        Upload a browser-exported <code>bookmarks.html</code> to seed your library.
      </p>
    </.link>

    <.link
      href={~p"/backup"}
      class="block rounded-lg border border-slate-400 bg-slate-100 p-6 shadow-sm hover:border-sky-500 hover:bg-sky-50"
    >
      <h3 class="text-lg font-semibold text-slate-950">Backup &amp; restore</h3>
      <p class="mt-1 text-sm text-slate-700">
        Export everything as a JSON file, or restore a previous backup.
      </p>
    </.link>
  </div>

  <div class="grid gap-6 lg:grid-cols-2 mb-8">
    <section class="rounded-lg border border-slate-400 bg-slate-100 p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-slate-950">Change email</h3>

      <div class="mt-5">
        <.form :let={f} for={@email_changeset} action={~p"/users/settings"} method="put">
          <div :if={@email_changeset.action} class="alert alert-danger">
            <p>Oops, something went wrong! Please check the errors below.</p>
          </div>

          <%= hidden_input f, :action, name: "action", value: "update_email" %>

          <div class="space-y-5">
            <div>
              <%= label f, :email, class: "block text-sm font-medium text-slate-700" %>
              <%= email_input f, :email,
                required: true,
                class:
                  "mt-2 block w-full rounded-md border border-slate-400 bg-slate-50 px-3 py-2 text-slate-950 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200" %>
              <%= error_tag f, :email %>
            </div>

            <div>
              <%= label f, :current_password,
                for: "current_password_for_email",
                class: "block text-sm font-medium text-slate-700" %>
              <%= password_input f, :current_password,
                required: true,
                name: "current_password",
                id: "current_password_for_email",
                class:
                  "mt-2 block w-full rounded-md border border-slate-400 bg-slate-50 px-3 py-2 text-slate-950 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200" %>
              <%= error_tag f, :current_password %>
            </div>

            <div>
              <%= submit "Change email",
                class:
                  "rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-sky-700" %>
            </div>
          </div>
        </.form>
      </div>
    </section>

    <section class="rounded-lg border border-slate-400 bg-slate-100 p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-slate-950">Change password</h3>

      <div class="mt-5">
        <.form :let={f} for={@password_changeset} action={~p"/users/settings"} method="put">
          <div :if={@password_changeset.action} class="alert alert-danger">
            <p>Oops, something went wrong! Please check the errors below.</p>
          </div>

          <%= hidden_input f, :action, name: "action", value: "update_password" %>

          <div class="space-y-5">
            <div>
              <%= label f, :password, "New password",
                class: "block text-sm font-medium text-slate-700" %>
              <%= password_input f, :password,
                required: true,
                class:
                  "mt-2 block w-full rounded-md border border-slate-400 bg-slate-50 px-3 py-2 text-slate-950 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200" %>
              <%= error_tag f, :password %>
            </div>

            <div>
              <%= label f, :password_confirmation, "Confirm new password",
                class: "block text-sm font-medium text-slate-700" %>
              <%= password_input f, :password_confirmation,
                required: true,
                class:
                  "mt-2 block w-full rounded-md border border-slate-400 bg-slate-50 px-3 py-2 text-slate-950 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200" %>
              <%= error_tag f, :password_confirmation %>
            </div>

            <div>
              <%= label f, :current_password,
                for: "current_password_for_password",
                class: "block text-sm font-medium text-slate-700" %>
              <%= password_input f, :current_password,
                required: true,
                name: "current_password",
                id: "current_password_for_password",
                class:
                  "mt-2 block w-full rounded-md border border-slate-400 bg-slate-50 px-3 py-2 text-slate-950 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200" %>
              <%= error_tag f, :current_password %>
            </div>

            <div>
              <%= submit "Change password",
                class:
                  "rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-sky-700" %>
            </div>
          </div>
        </.form>
      </div>
    </section>
  </div>

  <div class="rounded-lg border-2 border-rose-300 bg-rose-50 p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-rose-900">Danger zone</h2>
    <p class="mt-1 text-sm text-rose-900">
      Both actions are permanent. There is no undo. Type your email
      and current password to confirm.
    </p>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <section class="rounded-md border border-rose-300 bg-white p-5">
        <h3 class="text-base font-semibold text-rose-900">Empty account</h3>
        <p class="mt-1 text-sm text-rose-900">
          Deletes every bookmark and every tag in your account. Your
          login stays, so you can start over.
        </p>

        <.form
          :let={_f}
          for={%{}}
          as={:empty}
          action={~p"/users/settings"}
          method="put"
          class="mt-4 space-y-3"
        >
          <input type="hidden" name="action" value="empty_account" />

          <div>
            <label class="block text-sm font-medium text-rose-900" for="empty_email">
              Type your email (<%= @current_user.email %>)
            </label>
            <input
              id="empty_email"
              type="email"
              name="confirm_email"
              required
              autocomplete="off"
              class="mt-1 block w-full rounded-md border border-rose-400 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-200"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-rose-900" for="empty_password">
              Current password
            </label>
            <input
              id="empty_password"
              type="password"
              name="current_password"
              required
              class="mt-1 block w-full rounded-md border border-rose-400 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-200"
            />
          </div>

          <button
            type="submit"
            data-confirm="Delete every bookmark and tag in this account? This cannot be undone."
            class="rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-700"
          >
            Empty account
          </button>
        </.form>
      </section>

      <section class="rounded-md border border-rose-300 bg-white p-5">
        <h3 class="text-base font-semibold text-rose-900">Deactivate account</h3>
        <p class="mt-1 text-sm text-rose-900">
          Wipes all bookmarks and tags <em>and</em> deletes your
          login. You will be logged out and cannot sign back in.
        </p>

        <.form
          :let={_f}
          for={%{}}
          as={:deactivate}
          action={~p"/users/settings"}
          method="put"
          class="mt-4 space-y-3"
        >
          <input type="hidden" name="action" value="deactivate_account" />

          <div>
            <label class="block text-sm font-medium text-rose-900" for="deactivate_email">
              Type your email (<%= @current_user.email %>)
            </label>
            <input
              id="deactivate_email"
              type="email"
              name="confirm_email"
              required
              autocomplete="off"
              class="mt-1 block w-full rounded-md border border-rose-400 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-200"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-rose-900" for="deactivate_password">
              Current password
            </label>
            <input
              id="deactivate_password"
              type="password"
              name="current_password"
              required
              class="mt-1 block w-full rounded-md border border-rose-400 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-200"
            />
          </div>

          <button
            type="submit"
            data-confirm="Delete this account and all of its data forever?"
            class="rounded-md bg-rose-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-800"
          >
            Deactivate account
          </button>
        </.form>
      </section>
    </div>
  </div>
</section>
