{
  "name": "Tsundoku",
  "short_name": "Tsundoku",
  "description": "Personal bookmarks server",
  "start_url": "/sites",
  "scope": "/",
  "display": "standalone",
  "background_color": "#cbd5e1",
  "theme_color": "#0284c7",
  "icons": [
    { "src": "/images/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/images/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
